# Copy to .env (run_server.sh loads it). Everything here is optional.

# Data service: Vlada if set, else the public extracts in data/processed.
VLADA_API_KEY=

# Extra CORS origins for a deployed web app, comma-separated (e.g. http://<host>:3000), or * for any.
# http://localhost:* and http://127.0.0.1:* are always allowed.
HG_CORS_ORIGINS=

# Optimize jobs (POST /api/optimize): worker processes (default: cores - 4) and the default hospital.
HG_OPT_WORKERS=
HOSPITAL_ID=rwjuh_nb
