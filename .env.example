# Copy to .env. Each service goes online purely because its credential is present.
# Language model: Bedrock if AWS credentials resolve, else Anthropic if a key is set, else offline.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# or a Bedrock API key (bearer token) instead of the three AWS_* values above
AWS_BEARER_TOKEN_BEDROCK=
# comma-separated models to fall back to when the account refuses BEDROCK_MODEL_ID
BEDROCK_FALLBACK_MODEL_IDS=
BEDROCK_MODEL_ID=
# faster model for the short per-turn calls (intent, patient wording, grounding verifier); falls back to BEDROCK_MODEL_ID when empty or refused
BEDROCK_FAST_MODEL_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# same idea for the Anthropic API path (must be a model that accepts output_config.effort)
ANTHROPIC_FAST_MODEL=
# optional tuning of the online patient: which model words replies (fast|main), how model and keyword intent are combined
# (first|guarded|union|agree|model|offline), and the per-call timeout in seconds for calls made inside a turn
ENCOUNTER_WORDING_TIER=
ENCOUNTER_INTENT_COMBINE=
ENCOUNTER_LLM_TURN_TIMEOUT_S=
# which model the feedback grader's small concurrent calls use: fast (default, ~5 s) or main (~10 s)
ENCOUNTER_GRADER_TIER=
# Voice: ElevenLabs if set, else the browser's speech synthesis/recognition.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Data service: Vlada if set, else public extracts in data/processed.
VLADA_API_KEY=
