# Copy to .env. Each service goes online purely because its credential is present.
# Language model: Bedrock if AWS credentials resolve, else Anthropic if a key is set, else offline.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Voice: ElevenLabs if set, else the browser's speech synthesis/recognition.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Data service: Vlada if set, else public extracts in data/processed.
VLADA_API_KEY=
