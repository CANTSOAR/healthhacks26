# Copy to .env. Each service goes online purely because its credential is present.
# Language model: Bedrock if AWS credentials resolve, else Anthropic if a key is set, else offline.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# or a Bedrock API key (bearer token) instead of the three AWS_* values above
AWS_BEARER_TOKEN_BEDROCK=
# comma-separated models to fall back to when the account refuses BEDROCK_MODEL_ID
BEDROCK_FALLBACK_MODEL_IDS=
BEDROCK_MODEL_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Voice: ElevenLabs if set, else the browser's speech synthesis/recognition.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Data service: Vlada if set, else public extracts in data/processed.
VLADA_API_KEY=
