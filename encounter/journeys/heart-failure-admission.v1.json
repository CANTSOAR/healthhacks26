{
  "schema_version": 1,
  "journey_id": "heart-failure-admission",
  "version": 1,
  "title": "Breathless at 68: from the front door to the ward",
  "description": "Leonard Asante's admission seen by four professions. What he tells the triage nurse about his tablets, what the pharmacist finds in the dispensing record, and whether the admitting team hears about it at handoff.",
  "base_case": {
    "case_id": "breathless-retired-driver"
  },
  "stages": [
    {
      "stage_id": "triage",
      "title": "Triage",
      "interaction_type": "triage",
      "learner_role": {
        "staff_role": "rn",
        "label": "Triage nurse"
      },
      "counterparts": [
        {
          "kind": "patient"
        }
      ],
      "auto": {
        "clinician_id": "rosa-delgado"
      },
      "brief": "You are the triage nurse. Leonard Asante, 68, has been brought in by his daughter, short of breath. Find out what has changed, ask about his heart, his tablets and allergies, look at the vital signs, then assign an acuity (ESI 1 to 5) and write the note the physician will open with. Record what he tells you about his medicines in his own words.",
      "scope": {
        "fact_categories": [
          "identity",
          "chief_complaint",
          "hpi",
          "ros",
          "vitals",
          "allergies",
          "medications",
          "pmh",
          "concealed"
        ],
        "requests": [
          "exam:general"
        ]
      },
      "writes": {
        "required": [
          "acuity",
          "note"
        ],
        "optional": [
          "open_questions"
        ]
      },
      "minutes": 5,
      "objectives": [
        {
          "objective_id": "tri.complaint",
          "criterion": "Establishes the presenting complaint and its key features",
          "kind": "elicit",
          "behavior": "contribute",
          "categories": [
            "chief_complaint",
            "hpi"
          ],
          "min_fraction": 0.5
        },
        {
          "objective_id": "tri.allergies_meds",
          "criterion": "Checks allergies and current medicines",
          "kind": "elicit",
          "behavior": "contribute",
          "categories": [
            "allergies",
            "medications"
          ],
          "critical_only": false,
          "min_fraction": 0.5
        },
        {
          "objective_id": "tri.acuity",
          "criterion": "Assigns an acuity that fits the presentation",
          "kind": "decision_match",
          "behavior": "contribute",
          "key": "acuity"
        },
        {
          "objective_id": "tri.note",
          "criterion": "Writes a triage note for the next clinician",
          "kind": "write",
          "behavior": "communicate",
          "key": "note"
        },
        {
          "objective_id": "tri.pmh",
          "criterion": "Asks about known heart disease",
          "kind": "elicit",
          "behavior": "contribute",
          "categories": [
            "pmh"
          ],
          "min_fraction": 0.5
        }
      ]
    },
    {
      "stage_id": "clinician",
      "title": "Physician assessment",
      "interaction_type": "clinician_encounter",
      "learner_role": {
        "staff_role": "resident",
        "label": "Emergency physician"
      },
      "counterparts": [
        {
          "kind": "patient"
        }
      ],
      "auto": {
        "clinician_id": "jun-watanabe"
      },
      "brief": "You are the emergency physician. Open with the triage note. Work out why Mr. Asante has got worse now: history, examination, the tests you need. Decide on a disposition and write an assessment for the team.",
      "scope": {
        "fact_categories": "all",
        "requests": [
          "exam:*",
          "order:*"
        ]
      },
      "case_objectives": true,
      "writes": {
        "required": [
          "disposition",
          "note"
        ],
        "optional": [
          "orders",
          "plan",
          "open_questions"
        ]
      },
      "minutes": 15,
      "objectives": [
        {
          "objective_id": "md.use_triage",
          "criterion": "Builds on what triage recorded instead of starting over",
          "kind": "use_prior",
          "behavior": "use"
        },
        {
          "objective_id": "md.disposition",
          "criterion": "Reaches a disposition that fits the findings",
          "kind": "decision_match",
          "behavior": "contribute",
          "key": "disposition"
        },
        {
          "objective_id": "md.assessment",
          "criterion": "Writes an assessment the rest of the team can act on",
          "kind": "write",
          "behavior": "communicate",
          "key": "note"
        },
        {
          "objective_id": "md.uncertainty",
          "criterion": "Names what is still uncertain or pending",
          "kind": "identify_open",
          "behavior": "identify"
        }
      ]
    },
    {
      "stage_id": "medrec",
      "title": "Medication reconciliation",
      "interaction_type": "nursing_assessment",
      "learner_role": {
        "staff_role": "pharmacist",
        "label": "ED pharmacist"
      },
      "counterparts": [
        {
          "kind": "patient"
        }
      ],
      "auto": {
        "clinician_id": "samuel-adeyemi"
      },
      "brief": "You are the emergency department pharmacist. Triage recorded what Mr. Asante said about his tablets. Reconcile it: ask him, pull the dispensing record, ask about anything bought over the counter. If the record and his account disagree, raise it with him kindly and record what you find.",
      "scope": {
        "fact_categories": [
          "medications",
          "allergies",
          "pmh",
          "social",
          "concealed"
        ],
        "requests": [
          "order:medication_list",
          "order:prior_records"
        ]
      },
      "writes": {
        "required": [
          "med_list"
        ],
        "optional": [
          "note",
          "plan",
          "open_questions"
        ]
      },
      "minutes": 10,
      "objectives": [
        {
          "objective_id": "rx.use_prior",
          "criterion": "Starts from the medicines and allergies already on the record",
          "kind": "use_prior",
          "behavior": "use"
        },
        {
          "objective_id": "rx.history",
          "criterion": "Completes the medication and allergy history",
          "kind": "elicit",
          "behavior": "contribute",
          "categories": [
            "medications",
            "allergies"
          ],
          "critical_only": false,
          "min_fraction": 0.75
        },
        {
          "objective_id": "rx.source",
          "criterion": "Pulls the pharmacy dispensing record",
          "kind": "request",
          "behavior": "contribute",
          "requests": [
            "order:medication_list"
          ]
        },
        {
          "objective_id": "rx.discrepancy",
          "criterion": "Settles any conflict between what the patient says and what the record shows",
          "kind": "resolve_discrepancy",
          "behavior": "identify"
        },
        {
          "objective_id": "rx.list",
          "criterion": "Records a reconciled medication list",
          "kind": "write",
          "behavior": "communicate",
          "key": "med_list"
        }
      ]
    },
    {
      "stage_id": "handoff",
      "title": "Handoff",
      "interaction_type": "handoff",
      "learner_role": {
        "staff_role": "resident",
        "label": "Emergency physician (handing over)"
      },
      "counterparts": [
        {
          "kind": "colleague",
          "staff_role": "attending",
          "clinician_id": "helen-brandt",
          "label": "Hospital medicine attending"
        }
      ],
      "auto": {
        "clinician_id": "jun-watanabe"
      },
      "brief": "You are handing Mr. Asante over to the hospital medicine team. Give an SBAR from the shared record. The receiver wants to know why now, what he is really taking, what is pending, and what you need from her.",
      "sbar": {
        "max_questions": 3,
        "critical": [
          "allergies",
          "pending_results",
          "concealed",
          "disposition",
          "discrepancies",
          "critical_facts"
        ]
      },
      "writes": {
        "required": [
          "sbar"
        ]
      },
      "minutes": 10,
      "objectives": [
        {
          "objective_id": "sbar.situation",
          "criterion": "Situation: says what is happening with the patient now",
          "kind": "sbar",
          "behavior": "communicate",
          "element": "S"
        },
        {
          "objective_id": "sbar.background",
          "criterion": "Background: gives the history the receiver needs, including allergies and medicines",
          "kind": "sbar",
          "behavior": "communicate",
          "element": "B"
        },
        {
          "objective_id": "sbar.assessment",
          "criterion": "Assessment: reports the findings and what remains uncertain",
          "kind": "sbar",
          "behavior": "communicate",
          "element": "A"
        },
        {
          "objective_id": "sbar.recommendation",
          "criterion": "Recommendation: states the plan and what the receiver must do next",
          "kind": "sbar",
          "behavior": "communicate",
          "element": "R"
        },
        {
          "objective_id": "sbar.supported",
          "criterion": "States only what the shared record supports",
          "kind": "no_unsupported",
          "behavior": "communicate"
        }
      ]
    }
  ],
  "completion": {
    "rule": "all_stages"
  },
  "notes": "Stage durations for sampled stages and handoffs are assumed values. Scopes and objectives are a first draft for faculty review."
}